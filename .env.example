# Node identifier, sent to tenants in ticket requests and events.
NODE_ID=n1

# Address of the voice WebSocket listener. TLS is expected to be terminated by a reverse proxy.
VOICE_BIND=0.0.0.0:8080

# Optional TLS certificate and key (PEM). Unset to serve plain ws:// behind a TLS-terminating proxy.
#TLS_CERT=certs/voice.pem
#TLS_KEY=certs/voice-key.pem

# Comma-separated IPs of reverse proxies whose X-Forwarded-For header is trusted to carry the client address,
# or "all" to trust the header from any peer (only when the listener is reachable solely through proxies).
#TRUSTED_PROXIES=127.0.0.1,::1

# Media address announced to clients in READY.
MEDIA_IPV4=127.0.0.1
#MEDIA_IPV6=::1
MEDIA_PORT=50000

# Whether to serve an IPv6 endpoint if client has connected to the WebSocket over IPv6. If this is set to false, the server will only serve an IPv4 endpoint.
ENABLE_IPV6=true

# Minimum enforced gateway version.
MIN_GATEWAY_VERSION=1

# Transport encryption modes offered to clients, in order of preference.
# Supported: aead_aes256_gcm_rtpsize, aead_xchacha20_poly1305_rtpsize, plain (testing only).
ENCRYPTION_MODES=aead_aes256_gcm_rtpsize,aead_xchacha20_poly1305_rtpsize

# Region and capacity (max participants across all tenants) announced to tenants. Both optional.
#REGION=local
#CAPACITY=500

# Whether to enable E2EE encryption using https://daveprotocol.com. Not yet implemented.
ENABLE_DAVE=false

# Comma-separated tenant names. Each tenant is configured with TENANT_<NAME>_* variables.
TENANTS=mooncord

# Endpoint clients connect to for this tenant (host:port, announced to the tenant for VOICE_SERVER_UPDATE).
# Every tenant needs its own host; the WebSocket Host header selects the tenant.
TENANT_MOONCORD_ENDPOINT=mooncord.voice.localhost:8080
# The tenant's NATS server, and optionally a .creds file issued by the tenant.
TENANT_MOONCORD_NATS_URL=nats://127.0.0.1:4222
#TENANT_MOONCORD_NATS_CREDS=/path/to/mmrs.creds
# Prefix of all subjects used on the tenant's NATS.
TENANT_MOONCORD_SUBJECT_PREFIX=mmrs
# Minimum enforced gateway version for this tenant. Optional, defaults to MIN_GATEWAY_VERSION.
TENANT_MOONCORD_MIN_GATEWAY_VERSION=4
# Whether to require E2EE encryption for non-stage channels.
TENANT_MOONCORD_REQUIRE_DAVE=false